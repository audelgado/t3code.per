# /var/lib/cc/env, read by command-center.service. Owner cc, mode 600.
# The address you open on the phone: the tailnet name of this VPS plus the port of
# `tailscale serve --bg --https=8443 http://127.0.0.1:3900`.
CC_PUBLIC_URL=https://vps.your-tailnet.ts.net:8443
# Contact address sent with Web Push notifications. Any address you control.
CC_PUSH_SUBJECT=mailto:you@example.com
# Optional Orca page (More -> Orca). Path of the orca binary the cc user can run.
# CC_ORCA_CLI=/usr/local/bin/orca
# Orca environment id from `orca environment list`, passed as --environment to drive the PC's Orca runtime.
# CC_ORCA_ENV=
